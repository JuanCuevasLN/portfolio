---
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Abouts from '../components/Abouts.astro';
import '@fontsource/ibm-plex-sans';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class="no-scroll">
		<Loader />
		<Header />
		<Hero />
        <Abouts />
		<!-- <canvas id="mycanvas"></canvas> -->
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
        font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
	}

	/* Esta clase congelará la pantalla por completo */
	.no-scroll {
	overflow: hidden !important;
	}

	canvas {
        width: 100%;
        height: 100%;
		top: 0;
		 position: fixed;
    inset: 0;
    }

</style>

<script>
    import type { myParticle } from '../types/particula';

    document.addEventListener( 'DOMContentLoaded', () => {
        const canvas = document.querySelector<HTMLCanvasElement>('#mycanvas');
            
        if ( ! canvas ) return;

        const ctx = canvas.getContext('2d');
        if ( ! ctx ) return;

        canvas.width = window.innerWidth;
        canvas.height = 620;

        const particles: myParticle[] = [];
        const cant = 120;
        const colors =  [ '#EF26664b', '#C203F44b', '#f4e5b64b'];

        class Particle {
            radio : number;
            x: number;
            y: number;
            color: number;

            vx: number;
            vy: number;

            constructor( canvas: HTMLCanvasElement ){
                this.radio = (Math.random() * 0.4) + 1;

                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.color = Math.floor(Math.random() * 3);

                this.vx = Math.random() * 2 - 1; // Velocidad en X
                this.vy = Math.random() * 2 - 1;
            }

            drawParticle() : void {
                if ( ! ctx ) return;

                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radio, 0, Math.PI * 2);
                ctx.fillStyle = colors[this.color];
                ctx.fill();
                ctx.closePath();
            }

            updateParticle() : void {
                this.x += this.vx;
                this.y += this.vy;

                if ( ! canvas ) return;

                if (this.x - this.radio < 0 || this.x + this.radio > canvas.width) {
                    this.vx *= -1; 
                }
                if (this.y - this.radio < 0 || this.y + this.radio > canvas.height) {
                    this.vy *= -1; 
                }
            }
        }

        const createParticle = () => {
            for ( let i = 0; i < cant; i++ ) {
                particles.push( new Particle( canvas ) );
            }
        } 
        // createParticle()

        const animar = () => {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            if ( ! particles.length ) return;
            particles.forEach( (particle) => {
                particle.drawParticle();
                particle.updateParticle()
            });

            requestAnimationFrame(animar);
        }

        // animar();
    })
</script>
