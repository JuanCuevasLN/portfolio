---
import { Image } from "astro:assets";

import Gastro from '../assets/glitched-robot-face-portrait.webp';
import mandadito from '../assets/glitched-robot-face-portrait.webp';
import seguridad from '../assets/glitched-robot-face-portrait.webp';
---

<section class="section-experience">
    <div class="section-title-sticky-height">
        <div class="section-title-and-img-sticky">
            <h2 class="title-sticky">Proyectos destacados</h2>
            <div class="sectio-ima-sticky">
                <Image src={Gastro} alt="Descripción de la imagen" class='proyect-img one' />
                <Image src={mandadito} alt="Descripción de la imagen" class='proyect-img two' />
                <Image src={seguridad} alt="Descripción de la imagen" class='proyect-img three' />
            </div>
        </div>
    </div>
    <div class="section-information-project">

    </div>
</section>

<style>
    .section-experience  {
        width: 100%;
        height: auto;
        background: #000107;
    }

    .section-title-sticky-height {
        --height-content: auto;
        width: 100%;
        
        height: var(--height-content);
        display: flex;
        align-items: start;

        justify-content: center;
    }

    .section-title-and-img-sticky {
        width: 100%;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: sticky;
        top: 0;

        background: linear-gradient(115deg, transparent 0 18%, rgb(#000107) 18.1% 18.45%, transparent 18.7% 100%), linear-gradient(145deg, rgba(122, 92, 255, 0.2), transparent 34%), linear-gradient(315deg, rgba(255, 23, 79, 0.14), transparent 36%), linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent 36%), #080912;
    }

    .title-sticky {
        --translateY: 0;
        --opacidad: 1;

        transform: translateY( var(--translateY) );
        opacity: var(--opacidad);
        font-size: 72px;
        font-weight: 700;
        color: #dce6ee;
        letter-spacing: -2.5;
        line-height: 1;
        z-index: 10;
    }

    .sectio-ima-sticky {
        width: 90%;
        height: 90%;
        position: absolute;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .proyect-img  {
        --scaleVal: 1;
        transform: scale( var(--scaleVal));
        position: absolute;
    }

    .proyect-img.one {
        width: 180px;
        height: 180px;
        left: 0;
        right: 0;
        margin: auto;
        top: 10%;
    }

    .proyect-img.two {
        width: 210px;
        height: 180px;
        top: 25%;
        left: 0%;
    }

    .proyect-img.three {
        width: 210px;
        height: 180px;
        top: 40%;
        right: 2%;
    }

    .section-information-project {
        width: 100%;
        height: 550px;
        background: #fff;
    }
</style>

<script>
import type { boolean, hash } from "astro:schema";


    document.addEventListener('DOMContentLoaded', () => {
        const sectionSticky = document.querySelector('.section-title-sticky-height') as HTMLElement | null;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const titleSticky = document.querySelector('.title-sticky') as HTMLElement | null;
        const supportIntersectionObserver = 'IntersectionObserver' in window;

        if ( ! sectionSticky ) return;
        
        let ticking: boolean = false;
        let start: number = 0;
        let end: number = 0;

        let secondStart = 0;
        let secondEnd = 0;

        const SMOOTH: number = 0.12;
        const SMOOTH_EPSILON: number = 0.001;
        let actual: null | number = null;
        let secondHow: null | number = null;

        const clamp = (val: number, min: number, max: number) => {
            return Math.max( min, Math.min(val, max));
        }

        const updateAnimation = (): boolean => {
            const rect = sectionSticky.getBoundingClientRect();
            if ( ! rect ) return false;

            const rawProgress = ( start - rect.top) / (start - end);
            const progress = clamp(rawProgress, 0, 1);

            if ( actual === null ) {
                actual = progress;
            } else {
                actual += ( progress - actual ) * SMOOTH;
            }

            if ( Math.abs( progress - actual) < SMOOTH_EPSILON ) {
                actual = progress
            }

            const rawProgressSecond = ( secondStart - rect.top ) / ( secondStart - secondEnd );
            const progressSecond = clamp( rawProgressSecond, 0, 1);

            if ( secondHow === null ) {
                secondHow = progressSecond;
            } else {
                secondHow += ( progressSecond - secondHow ) * SMOOTH;
            }

            if ( Math.abs( progressSecond - secondHow) < SMOOTH_EPSILON ) {
                secondHow = progressSecond
            }
            
            if ( actual === null || secondHow === null ) return false;
           
            // Animaciones de imaen
            const sectioImaSticky = document.querySelectorAll('.proyect-img');
            sectioImaSticky.forEach(element => {
                if ( actual ) {
                    (element as HTMLElement).style.setProperty( '--scaleVal', actual.toString() );
                }
            });

            //Animaciones texto
            if ( ! titleSticky ) return false;
            titleSticky.style.setProperty( '--opacidad', actual.toString() );

            const translateY = 200 + (0 - 200) * actual;     

            titleSticky.style.setProperty( '--translateY', translateY.toString() );


            //Animacion desaparecen Imagenes
            console.log(progress, actual, '----', progressSecond, secondHow );
            
            return actual !== progress || secondHow !== progressSecond ;
        }

        const tick = () => {
            if (updateAnimation()) {
                requestAnimationFrame(tick)
            } else {
                ticking = false;
            }
        } 

        const requestUpdate = () => {
            if ( ticking ) return;
           
            ticking = true;
            requestAnimationFrame( tick ) 
        }

        const observer = supportIntersectionObserver ? 
            new IntersectionObserver( (entries) => {
                entries.forEach( (entry) => {
                    if ( entry.isIntersecting ) {
                        window.addEventListener( 'scroll', requestUpdate, { passive: true} );
                    } else {
                        window.removeEventListener( 'scroll', requestUpdate );
                    }
                });
            })
        : null;

        const animation = () => {
            if ( !observer ) return;
            observer.observe(sectionSticky);
        }

        const initSectionAnimation = () => {
            const sectioImaSticky = document.querySelectorAll('.proyect-img');

            if ( !sectionSticky || !titleSticky || sectioImaSticky.length === 0 ) return;

            sectionSticky.style.setProperty( "--height-content",  '1200px' );
            titleSticky.style.setProperty( '--translateY', '200px' );
            titleSticky.style.setProperty( '--opacidad', '0' );

            sectioImaSticky.forEach(ima => {
                (ima as HTMLElement).style.setProperty( '--scaleVal', '0');
            });
            
            const rect = sectionSticky.getBoundingClientRect();
            const vh = window.innerHeight;

            start = vh * 0.6;
            end = 0;

            secondStart = -100;
            secondEnd = vh - rect.height;
        }

        if ( !reduceMotion ) {
            initSectionAnimation();
            animation();
        }
    });
</script>
