---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Logro {
  titulo: string;
  descripcion?: string;
  icono?: string; // si no se pasa, se usa el icono de destellos
}

interface Tecnologia {
  icono: string;
  nombre: string;
}

interface Props {
  etiqueta?: string; // texto pequeño con línea, ej. "Mis proyectos"
  categoria?: string; // tipo: "Aplicación web", "Página web"...
  iconoCategoria?: string;
  tituloLinea1: string;
  tituloLinea2?: string;
  descripcion: string;
  tipo?: string; // ej. "Proyecto académico"
  periodo?: string;
  resumen?: string; // frase corta para la franja morada
  imagen: ImageMetadata | string; // imagen grande
  imagenSecundaria?: ImageMetadata | string; // imagen pequeña de abajo a la derecha
  imagenMini?: ImageMetadata | string; // miniatura dentro de la franja
  imagenAlt?: string;
  logros: Logro[];
  tecnologias?: Tecnologia[];
  enlace?: string;
  textoEnlace?: string;
  invertido?: boolean; // true = collage a la derecha
}

const {
  etiqueta = 'Proyecto destacado',
  categoria,
  iconoCategoria = 'lucide:app-window',
  tituloLinea1,
  tituloLinea2,
  descripcion,
  tipo,
  periodo,
  resumen,
  imagen,
  imagenSecundaria,
  imagenMini,
  imagenAlt = tituloLinea1,
  logros,
  tecnologias = [],
  enlace,
  textoEnlace = 'Ver proyecto',
  invertido = false,
} = Astro.props;

const mini = imagenMini ?? imagen;
const secundaria = imagenSecundaria ?? imagen;
---

<article class:list={['proy', { 'proy--invertido': invertido }]}>
  <!-- ============ COLLAGE ============ -->
  <div class="proy__visual">
    <div class="proy__main">
      {
        typeof imagen === 'string' ? (
          <img src={imagen} alt={imagenAlt} loading="lazy" />
        ) : (
          <Image src={imagen} alt={imagenAlt} />
        )
      }
    </div>

    <div class="proy__second">
      {
        typeof secundaria === 'string' ? (
          <img src={secundaria} alt="" loading="lazy" />
        ) : (
          <Image src={secundaria} alt="" />
        )
      }
    </div>

    {
      (resumen || tipo || periodo) && (
        <div class="proy__banner">
          <div class="proy__thumb">
            {typeof mini === 'string' ? (
              <img src={mini} alt="" loading="lazy" />
            ) : (
              <Image src={mini} alt="" />
            )}
          </div>
          <div class="proy__banner-text">
            {(tipo || periodo) && (
              <p class="proy__banner-meta">{[tipo, periodo].filter(Boolean).join(' · ')}</p>
            )}
            {resumen && <p class="proy__banner-quote">“{resumen}”</p>}
          </div>
        </div>
      )
    }
  </div>

  <!-- ============ TEXTO ============ -->
  <div class="proy__info">
    <div class="proy__eyebrow">
      <i class="proy__eyebrow-line"></i>
      <span class="proy__eyebrow-text">{etiqueta}</span>
      {
        categoria && (
          <span class="proy__chip">
            <Icon name={iconoCategoria} />
            {categoria}
          </span>
        )
      }
    </div>

    <h3 class="proy__title">
      {tituloLinea1}
      {tituloLinea2 && ` ${tituloLinea2}`}
    </h3>

    <p class="proy__desc">{descripcion}</p>

    <ul class="proy__list">
      {
        logros.map((l) => (
          <li>
            <Icon name={l.icono ?? 'lucide:sparkles'} class="proy__list-icon" />
            <div>
              <strong>{l.titulo}</strong>
              {l.descripcion && <span>{l.descripcion}</span>}
            </div>
          </li>
        ))
      }
    </ul>

    {
      tecnologias.length > 0 && (
        <ul class="proy__tech">
          {tecnologias.map((t) => (
            <li>
              <Icon name={t.icono} />
              <span>{t.nombre}</span>
            </li>
          ))}
        </ul>
      )
    }

    {
      enlace && (
        <a class="proy__btn" href={enlace}>
          {textoEnlace}
          <Icon name="lucide:arrow-up-right" />
        </a>
      )
    }
  </div>
</article>

<style>
  .proy {
    --morado: #8b2cf5;
    --morado-claro: #c27bff;
    --texto: #0a0a14;
    --suave: #6b6f80;

    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: center;
    max-width: 1100px;
    margin-inline: auto;
    padding: 2rem;
    color: var(--texto);
  }

  .proy--invertido .proy__visual {
    order: 2;
  }

  /* ================= COLLAGE ================= */
  .proy__visual {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 450 / 370;
    margin-inline: auto;
  }

  .proy__main,
  .proy__second,
  .proy__thumb {
    overflow: hidden;
  }

  .proy__main :global(img),
  .proy__second :global(img),
  .proy__thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Imagen grande: esquina inferior derecha cortada + rayas */
  .proy__main {
    position: absolute;
    top: 0;
    left: 0;
    width: 61%;
    height: 100%;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 70px), calc(100% - 70px) 100%, 0 100%);
  }

  .proy__main::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 110px;
    height: 110px;
    background: repeating-linear-gradient(
      135deg,
      transparent 0 16px,
      rgba(255, 255, 255, 0.92) 16px 30px
    );
    pointer-events: none;
  }

  /* Imagen pequeña: esquinas opuestas cortadas */
  .proy__second {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 36%;
    height: 50%;
    clip-path: polygon(24px 0, 100% 0, 100% calc(100% - 24px), calc(100% - 24px) 100%, 0 100%, 0 24px);
  }

  /* Franja morada */
  .proy__banner {
    position: absolute;
    left: 1%;
    top: 49%;
    width: 98%;
    min-height: 19%;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.55rem 1.1rem 0.55rem 0.6rem;
    color: #fff;
    background: linear-gradient(100deg, #7a22ee 0%, #a64cf8 55%, #c58bff 100%);
    clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%);
    box-shadow: 0 14px 30px -14px rgba(122, 34, 238, 0.7);
  }

  .proy__thumb {
    flex: 0 0 68px;
    width: 68px;
    height: 68px;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 16px 100%, 0 calc(100% - 16px));
  }

  .proy__banner-text {
    min-width: 0;
  }

  .proy__banner-meta {
    margin: 0 0 0.2rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .proy__banner-quote {
    margin: 0;
    font-size: 0.78rem;
    font-style: italic;
    font-weight: 500;
    line-height: 1.4;
  }

  /* ================= INFO ================= */
  .proy__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    min-width: 0;
  }

  .proy__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }

  .proy__eyebrow-line {
    width: 52px;
    height: 1px;
    background: var(--morado);
  }

  .proy__eyebrow-text {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--morado);
  }

  .proy__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem 0.3rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #5a2fd6;
    background: #f0ecff;
    border: 1px solid #ddd3ff;
    border-radius: 999px;
  }

  .proy__chip :global(svg) {
    width: 15px;
    height: 15px;
  }

  .proy__title {
    margin: 0;
    max-width: 17ch;
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .proy__desc {
    margin: 0;
    max-width: 50ch;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--suave);
  }

  /* Lista con destellos */
  .proy__list {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }

  .proy__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .proy__list :global(.proy__list-icon) {
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    margin-top: 0.15rem;
    color: var(--morado);
  }

  .proy__list strong {
    display: block;
    font-weight: 600;
  }

  .proy__list span {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8rem;
    color: var(--suave);
  }

  /* Tecnologías */
  .proy__tech {
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .proy__tech li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem 0.35rem 0.55rem;
    font-size: 0.78rem;
    font-weight: 600;
    background: #fff;
    border: 1px solid #e4e0f5;
    border-radius: 999px;
  }

  .proy__tech :global(svg) {
    width: 18px;
    height: 18px;
  }

  /* Botón con esquina cortada */
  .proy__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
    padding: 0.85rem 1.6rem 0.85rem 1.4rem;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
    background: linear-gradient(90deg, #a21df0 0%, #e4437a 60%, #ff7a1a 100%);
    border-radius: 6px 0 0 6px;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .proy__btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
  }

  .proy__btn :global(svg) {
    width: 16px;
    height: 16px;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 900px) {
    .proy {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 1.25rem;
    }

    .proy--invertido .proy__visual {
      order: 0;
    }

    .proy__title {
      max-width: none;
    }
  }

  @media (max-width: 520px) {
    .proy__banner-quote {
      font-size: 0.7rem;
    }

    .proy__thumb {
      flex-basis: 52px;
      width: 52px;
      height: 52px;
    }
  }
</style>