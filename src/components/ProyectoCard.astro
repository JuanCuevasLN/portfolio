---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Logro {
  titulo: string;
  descripcion?: string;
  icono?: string; // si no se pasa, se usa el icono de destellos
}

interface Tecnologia {
  icono: string;
  nombre: string;
}

interface Props {
  etiqueta?: string; // texto pequeño con línea, ej. "Mis proyectos"
  categoria?: string; // tipo: "Aplicación web", "Página web"...
  iconoCategoria?: string;
  tituloLinea1: string;
  tituloLinea2?: string;
  descripcion: string;
  tipo?: string; // ej. "Proyecto académico"
  periodo?: string;
  resumen?: string; // frase corta para la franja morada
  imagen: ImageMetadata | string; // imagen grande
  imagenSecundaria?: ImageMetadata | string; // imagen pequeña de abajo a la derecha
  imagenMini?: ImageMetadata | string; // miniatura dentro de la franja
  imagenAlt?: string;
  logros: Logro[];
  tecnologias?: Tecnologia[];
  enlace?: string;
  textoEnlace?: string;
  invertido?: boolean; // true = collage a la derecha
}

const {
  etiqueta = "Proyecto destacado",
  categoria,
  iconoCategoria = "lucide:app-window",
  tituloLinea1,
  tituloLinea2,
  descripcion,
  tipo,
  periodo,
  resumen,
  imagen,
  imagenSecundaria,
  imagenMini,
  imagenAlt = tituloLinea1,
  logros,
  tecnologias = [],
  enlace,
  textoEnlace = "Ver proyecto",
  invertido = false,
} = Astro.props;

const mini = imagenMini ?? imagen;
const secundaria = imagenSecundaria ?? imagen;
---

<article class:list={["proy", { "proy--invertido": invertido }]}>
  <!-- ============ COLLAGE ============ -->
  <div class="proy__visual">
    <div class="proy__main">
      {
        typeof imagen === "string" ? (
          <img src={imagen} alt={imagenAlt} loading="lazy" class="proy_main-img" />
        ) : (
          <Image src={imagen} alt={imagenAlt} class="proy_main-img" />
        )
      }
    </div>

    {
      (resumen || tipo || periodo) && (
        <div class="proy__banner">
          <div class="proy__thumb">
            {typeof mini === "string" ? (
              <img src={mini} alt="" loading="lazy" />
            ) : (
              <Image src={mini} alt="" />
            )}
          </div>
          <div class="proy__banner-text">
            {(tipo || periodo) && (
              <p class="proy__banner-meta">
                {[tipo, periodo].filter(Boolean).join(" · ")}
              </p>
            )}
            {resumen && <p class="proy__banner-quote">“{resumen}”</p>}
          </div>
        </div>
      )
    }
  </div>

  <!-- ============ TEXTO ============ -->
  <div class="proy__info">
    <div class="proy-content__info">
      <div class="proy__eyebrow">
        <i class="proy__eyebrow-line"></i>
        <span class="proy__eyebrow-text">{etiqueta}</span>
        {
          categoria && (
            <span class="proy__chip">
              <Icon name={iconoCategoria} />
              {categoria}
            </span>
          )
        }
      </div>

      <h3 class="proy__title">
        {tituloLinea1}
        {tituloLinea2 && ` ${tituloLinea2}`}
      </h3>

      <p class="proy__desc">{descripcion}</p>
    </div>

    <div class="proy-content__second">
      <div class="proy__second">
        {
          typeof secundaria === "string" ? (
            <img src={secundaria} alt="" loading="lazy" class="proy__second-img" />
          ) : (
            <Image src={secundaria} alt="" class="proy__second-img" />
          )
        }
      </div>
      <div class="proy__list-content">
        <ul class="proy__list">
          {
            logros.map((l) => (
              <li>
                <Icon
                  name={l.icono ?? "lucide:sparkles"}
                  class="proy__list-icon"
                />
                <div>
                  <strong>{l.titulo}</strong>
                  {l.descripcion && <span>{l.descripcion}</span>}
                </div>
              </li>
            ))
          }
        </ul>
        {
          tecnologias.length > 0 && (
            <ul class="proy__tech">
              {tecnologias.map((t) => (
                <li>
                  <Icon name={t.icono} />
                  <span>{t.nombre}</span>
                </li>
              ))}
            </ul>
          )
        }
        {
          enlace && (
            <a class="proy__btn" href={enlace}>
              {textoEnlace}
              <Icon name="lucide:arrow-up-right" />
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .proy {
    --morado: #8b2cf5;
    --morado-claro: #c27bff;
    --texto: #0a0a14;
    --suave: #6b6f80;

    display: flex;
    gap: 1.5rem;
    align-items: center;
    max-width: 100%;
    height: 560px;
    margin-inline: auto;
    padding: 2rem;
    color: var(--texto);
  }

  /* ================= COLLAGE ================= */
  .proy__visual {
    position: relative;
    width: 40%;
    height: 100%;
    aspect-ratio: 450 / 370;
    margin-inline: auto;
  }

  .proy__main,
  .proy__thumb {
    overflow: hidden;
  }

  .proy__main :global(img),
  .proy__second :global(img),
  .proy__thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Imagen grande: esquina inferior derecha cortada + rayas */
  .proy__main {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - 70px),
      calc(100% - 70px) 100%,
      0 100%
    );
  }

  .proy__main::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    width: 110px;
    height: 110px;
    background: repeating-linear-gradient(
      135deg,
      transparent 0 16px,
      rgba(255, 255, 255, 0.92) 16px 30px
    );
    pointer-events: none;
  }

  /* Franja morada */
.proy__banner {
  position: absolute;
  left: 1%;
  top: 65%;
  height: 80px;
  width: 120%;
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding: 0.7rem 1.2rem 0.7rem 0.8rem;
  color: #fff;

  /* degradado con transparencia */
  background: linear-gradient(
    90deg,
    rgb(163, 29, 240) 0%,
    rgba(228, 67, 121, 0.789) 60%,
    rgb(255, 121, 26) 100%
  );

  /* el efecto de vidrio */
  backdrop-filter: blur(14px) saturate(1.4);
  -webkit-backdrop-filter: blur(14px) saturate(1.4);

  clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%);

  /* borde de luz interior (el border normal se cortaría con el clip-path) */
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45),
              inset 0 0 0 1px rgba(255, 255, 255, 0.18);
}

  .proy__thumb {
    flex: 0 0 78px;
    width: 78px;
    height: 74px;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 16px 100%, 0 calc(100% - 16px));
  }

  .proy__banner-text {
    min-width: 0;
  }

  .proy__banner-meta {
    margin: 0 0 0.2rem;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .proy__banner-quote {
    margin: 0;
    font-size: 0.88rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.4;
  }

  /* ================= INFO ================= */
  .proy-content__second {
    width: 100%;
    height: 340px;
    gap: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Imagen pequeña: esquinas opuestas cortadas */
  .proy__second {
    position: relative;
    right: 0;
    bottom: 0;
    width: 50%;
    height: 100%;
    clip-path: polygon(
      24px 0,
      100% 0,
      100% calc(100% - 24px),
      calc(100% - 24px) 100%,
      0 100%,
      0 24px
    );
  }

  .proy__second-img {
    transform: translateX(-25px);
  }

  .proy__info {
    width: 50%;
    height: 560px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    min-width: 0;
  }

  .proy-content__info {
    width: 100%;
    height: 220px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    min-width: 0;
  }

  .proy__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }

  .proy__eyebrow-line {
    width: 52px;
    height: 1px;
    background: var(--morado);
  }

  .proy__eyebrow-text {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--morado);
  }

  .proy__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem 0.3rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #5a2fd6;
    background: #f0ecff;
    border: 1px solid #ddd3ff;
    border-radius: 999px;
  }

  .proy__chip :global(svg) {
    width: 15px;
    height: 15px;
  }

  .proy__title {
    margin: 0;
    max-width: 20ch;
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .proy__desc {
    margin: 0;
    font-size: 0.97rem;
    line-height: 1.1;
    color: #303136;
  }

  /* Lista con destellos */
  .proy__list-content {
    width: 55%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: center;
    gap: 25px;
  }

  .proy__list {
    width: 100%;
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }

  .proy__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .proy__list :global(.proy__list-icon) {
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    margin-top: 0.15rem;
    color: var(--morado);
  }

  .proy__list strong {
    display: block;
    font-weight: 600;
  }

  .proy__list span {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.85rem;
    color: #303136;
  }

  /* Tecnologías */
  .proy__tech {
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .proy__tech li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem 0.35rem 0.55rem;
    font-size: 0.78rem;
    font-weight: 600;
    background: #fff;
    border: 1px solid #e4e0f5;
    border-radius: 999px;
  }

  .proy__tech :global(svg) {
    width: 18px;
    height: 18px;
  }

  /* Botón con esquina cortada */
  .proy__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
    padding: 0.85rem 1.6rem 0.85rem 1.4rem;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
    background: linear-gradient(90deg, #a21df0 0%, #e4437a 60%, #ff7a1a 100%);
    border-radius: 6px 0 0 6px;
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - 14px),
      calc(100% - 14px) 100%,
      0 100%
    );
    transition:
      transform 0.2s ease,
      filter 0.2s ease;
  }

  .proy__btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
  }

  .proy__btn :global(svg) {
    width: 16px;
    height: 16px;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 900px) {
    .proy {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 1.25rem;
    }

    .proy--invertido .proy__visual {
      order: 0;
    }

    .proy__title {
      max-width: none;
    }
  }

  @media (max-width: 520px) {
    .proy__banner-quote {
      font-size: 0.7rem;
    }

    .proy__thumb {
      flex-basis: 52px;
      width: 52px;
      height: 52px;
    }
  }
</style>
