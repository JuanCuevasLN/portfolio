<div class="loader-wrapper">
    <div class="loader-text">
        <div class="text-left">
            <span class="texto text-move-left">Juan Cuevas</span>
        </div>
        <div class="text-right">
            <span class="texto text-move-right"> Hernández </span>
        </div>
    </div>

    <div class="loader-im">
        <img class="image" src="https://www.villalon.engineering/vex-demo/wp-content/uploads/sites/6/2026/10/astronaut-cosmic-jellyfish-scene.webp" alt="">
    </div>

    <div class="loader-contador">
        <div class="content-progreso"> 
            <span class="proreso">0</span> 
            % 
        </div>
    </div>
</div>

<style>
    .loader-wrapper {
        position: fixed;
        width: 100%;
        height: 100vh;
        display: flex;
        gap: 10px;
        align-items: center;
        flex-direction: column;
        justify-content: center;
		background: #04040e;

        transition: opacity 0.5s ease, visibility 0.5s ease;
        z-index: 99999;
	}

    .loader-wrapper.hidden { 
        opacity: 0;
        visibility: hidden;
    } 

    .loader-text {
        width: 100%;
        height: 45vh;
        display: flex;
        align-items: center;
        flex-direction: column;
        justify-content: center;
	}

    .text-left {
        width: 95%;
        display: flex;
        align-items: center;
        transform: translateX(-100%);
        justify-items: start;
        transition: transform 0.8s ease;
    }

    .text-left.reveal { 
        transform: translateX(0);
    } 

    .text-left span {
        color: transparent;
        -webkit-text-stroke: 1px white;
    }

    .text-move-left.move { 
        animation: move-right 3s infinite;
    } 

    .text-move-right.move { 
        animation: move-left 3s infinite;
    } 

    @keyframes move-right {
        10% {
            transform: translateX(0px);
        } 

        50% {
            transform: translateX(80px);
        }

        100% {
            transform: translateX(0px);
        }
    } 

    @keyframes move-left {
        10% {
            transform: translateX(0px);
        } 

        50% {
            transform: translateX(-80px);
        }

        100% {
            transform: translateX(0px);
        }
    } 

    .text-right  {
        width: 95%;
        display: flex;
        align-items: center;
        justify-content: end;
        transform: translateX(100%);
        transition: transform 0.8s ease;
    }

    .text-right.reveal  { 
        transform: translateX(0);
    } 

    .text-right span {
        color: #fff;
    }

    .loader-text span {
        font-size: 115px;
        text-transform: uppercase;
        font-weight: 600;
	}

    .loader-im {
        width: 90%;
        height: 30vh;
        display: flex;
        align-items: center;
        justify-content: start;
    }

    .loader-im img {
        width: 320px;
        height: 95%;
        opacity: 0;
        transform: scale(0.5);
        transition: opacity 0.6s ease-in, transform 0.3s ease;
    }

    .loader-im .image.reveal {
        opacity: 1;
        transform: scale(1);
    }

    .loader-contador {
        width: 95%;
        height: 20vh;
        display: flex;
        align-items: center;
        justify-content: end;
    }

    .content-progreso {
        font-size: 140px;
        font-weight: 600;
        color: transparent;
        -webkit-text-stroke: 1px white;
    }
</style>

<script>

window.addEventListener('load', () => {
    const initContentReveal = () => { 
        const textLeft = document.querySelector('.text-left');
        const textRight = document.querySelector('.text-right');

        if ( textLeft ) textLeft.classList.add('reveal');

        if ( textRight ) textRight.classList.add('reveal');

        const img = document.querySelector('.image');
        if ( img ) img.classList.add('reveal')
    }
        
    initContentReveal();

    setTimeout(() => {
        // Contador
        const numberEle = document.querySelector('.proreso');
        const duration: number = 800;
        const timeInit = performance.now();

        //Imaen movimiento
        const contIma = document.querySelector('.loader-im');
        const rectContIma = contIma?.getBoundingClientRect();
        const ima = document.querySelector('.image') as HTMLElement;
        const rectIma = ima?.getBoundingClientRect();
        const start = rectIma?.right;
        const end = rectContIma?.right;

        // text move 
        const textLeft = document.querySelector('.text-move-left');
        if ( textLeft ) textLeft.classList.add('move');

        const textRight = document.querySelector('.text-move-right');
        if ( textRight ) textRight.classList.add('move');

        if ( ! start || ! end ) return;

        const initLoaderTime = ( timeHow: any ) => {
            const progress = Math.min( ((timeHow - timeInit ) / duration), 1);
                
            let cont = Math.floor( progress * 100 );
            if ( numberEle ) numberEle.textContent = cont.toString();

            const translateX = (( end - start) * progress ) + start;
            if (ima) ima.style.transform = `translateX(${translateX - start}px)`;
              
            if ( progress < 1 ) requestAnimationFrame(initLoaderTime);
        }

        requestAnimationFrame(initLoaderTime);
    }, 800);

    setTimeout( () => { 
       const loader = document.querySelector('.loader-wrapper');
       if ( !loader ) return; 

       loader.classList.add('hidden');


    }, 2100 )
});
</script>