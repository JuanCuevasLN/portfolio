---
import { Image } from "astro:assets";
import villalon from "../assets/nest.png";
import imageReveal from '../assets/android-woman-headphones-profile.webp'

import fondo from '../assets/fondo-dark.png'
---

<section class="section-abouts">
    <div class="section-info">
        <div class="section-title">
            <div class="section-title-fondo-blur">
                <h2 class="subtitle">Experiencia Profecional</h2>
            </div>

            <Image src={imageReveal} alt="Descripción de la imagen" class='ima-reveal' />
        </div>
        <div class="section-cards">
            <section class="experience-card">
                <div class="experience-content">
                    <header class="experience-header">
                        <h2>Desarrollador Full Stack</h2>
                        <div class="experience-meta">
                            <span class="experience-company">
                                Villalon Engieneering
                            </span>
                            <span class="experience-period">
                                Ene. 2025 — Sep. 2026
                            </span>
                        </div>
                    </header>

                    <div class="experience-divider"></div>

                    <ul class="experience-details">
                        <li>
                            Desarrollo de aplicaciones con Angular: Desarrollé
                            múltiples módulos utilizando Angular, implementado
                            operaciones CRUD, servicios y modelos de datos para
                            gestionar entidades e integrar funcionalidades
                            mediante APIs REST
                        </li>
                        <li>
                            Desarrollo e integración de backend: Trabajé con
                            APIs REST desarrolladas con NestJS y Express,
                            participando tanto en su consumo desde el frontend
                            como en el desarrollo de las mismas
                        </li>
                        <li>
                            Desarrollo de themes avanzados para wordpress:
                            Colaboré en la creación de un theme personalizado
                            compatible con múltiples plugins, integrando
                            herramientas como Elementor y Yoast SEO, además de
                            soluciones de traducción y autenticación en dos
                            pasos
                        </li>
                        <li>
                            Desarrollo de plugins personalizados: Creé un plugin
                            para la empresa para extender funcionalidades y
                            modificar el comportamiento de herramientas como
                            Elementor y Eventin, adaptándolas a los
                            requerimientos específicos de los proyectos.
                        </li>
                        <li>
                            Desarrollo del sitio web corporativo: Desarrollé el
                            sitio web actual de la empresa, mejorando su
                            interactividad mediante animaciones y
                            funcionalidades dinámicas, e integrando el theme y
                            plugins personalizados creados previamente
                        </li>
                    </ul>
                </div>
            </section>

            <section class="experience-card">
                <div class="experience-content">
                    <header class="experience-header">
                        <h2>Soporte técnico</h2>
                        <div class="experience-meta">
                            <span class="experience-company">
                                Secretaría de finanzas
                            </span>
                            <span class="experience-period">
                                Abril. 2023 — Agosto. 2023
                            </span>
                        </div>
                    </header>

                    <div class="experience-divider"></div>

                    <ul class="experience-details">
                        <li>
                            Desarrollé un sistema de gestión de tickets
                            utilizando JavaScript, PHP, HTML y CSS para
                            optimizar la atención de solicitudes internas y
                            agilizar los procesos operativos de las oficinas.
                        </li>
                        <li>
                            Mantenimiento y soporte técnico: Realicé
                            mantenimiento preventivo y correctivo a equipos de
                            cómputo, así como el diagnóstico y la resolución de
                            incidencias técnicas.
                        </li>
                        <li>
                            Soporte de infraestructura de red: Brindé
                            mantenimiento y soporte a la conectividad de las
                            oficinas, trabajando con infraestructura y equipos
                            de red Cisco.
                        </li>
                    </ul>
                </div>
            </section>
        </div>
    </div>
</section>

<style>
    .section-abouts {
        width: 100%;
        height: 1200px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000107;
        position: relative;
        z-index: 10000;
    }

    .section-info {
        width: 100%;
        height: 1000px;
        display: flex;
        align-items: start;
        justify-content: center;
        gap: 20px;
    }

    .section-title {
        width: 30%;
        height: 580px;
        position: sticky;
        top: 0;
        display: flex;
    }

    .ima-reveal {
        width: 380px;
        height: 430px;
        position: absolute;
        left: -35%;
        top: 40%;
        transform: translateX(-300px);
        opacity: 0;
        transition: transform 0.6s ease-out, opacity 0.6s ease-out;
    }

    .ima-reveal.reveal {
        opacity: 1;
        transform: translateX(0);
    }

    .subtitle {
        font-size: 50px;
        font-weight: 700;
        color: #dce6ee;
        letter-spacing: -2.5;
        line-height: 1;
    }

    .section-cards {
        width: 50%;
        height: 1200px;
        display: flex;
        flex-direction: column;
        gap: 45px;
    }

    .experience-card {
        --accent: #7547ff;
        --text: #edebf8;
        --muted: #c4c3c8;

        gap: 32px;

        width: 100%;
        max-width: 1000px;
        height: auto;
        padding: 25px;

        display: flex;
        align-items: center;
        justify-content: center;
        background: #00030f;
        backdrop-filter: blur(32px) saturate(185%);
        border-radius: 6px;
        border: 1px solid #9136EB;
        box-sizing: border-box;
        overflow: hidden;

        clip-path: polygon(
            60px 0,
            /* arriba, después del corte izq. */ 100% 0,
            /* arriba derecha */ 100% calc(100% - 60px),
            /* derecha, antes del corte inferior */ calc(100% - 60px) 100%,
            /* abajo, antes del corte der. */ 0 100%,
            /* abajo izquierda */ 0 60px /* izquierda, debajo del corte */
        );
    }

    /* Imagen con recorte geométrico */

    .experience-image {
        height: 275px;
        min-width: 0;
        overflow: hidden;

        clip-path: polygon(0 18%, 22% 0, 100% 0, 100% 82%, 82% 100%, 0 100%);
    }

    .experience-image .work {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;

        transition: transform 0.5s ease;
    }

    .experience-card:hover .experience-image .work {
        transform: scale(1.05);
    }

    /* Información de experiencia */

    .experience-content {
        width: 85%;
        padding: 4px 8px 4px 0;
    }

    .experience-header h2 {
        margin: 0;
        color: var(--text);

        font-size: clamp(25px, 3vw, 37px);
        font-weight: 800;
        line-height: 1.08;
        letter-spacing: -1.2px;
    }

    .experience-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 16px;

        margin-top: 14px;
        font-size: 14px;
    }

    .experience-company {
        color: var(--text);
        font-weight: 700;
    }

    .experience-period {
        color: var(--muted);
    }

    /* Línea divisoria */

    .experience-divider {
        position: relative;
        height: 1px;
        margin: 24px 0;

        background: #dedce4;
    }

    .experience-divider::before {
        content: "";
        position: absolute;
        left: -9px;
        top: -2px;

        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--accent);
    }

    /* Responsabilidades en puntos */

    .experience-details {
        display: flex;
        flex-direction: column;
        gap: 10px;

        margin: 0;
        padding: 0;
        list-style: none;
    }

    .experience-details li {
        position: relative;
        padding-left: 17px;

        color: var(--muted);
        font-size: 14px;
        line-height: 1.6;
    }

    .experience-details li::before {
        content: "";
        position: absolute;
        top: 8px;
        left: 0;

        width: 6px;
        height: 6px;
        border-radius: 2px;
        background: var(--accent);

        transform: rotate(45deg);
    }

    /* Adaptación a pantallas pequeñas */

    @media (max-width: 650px) {
        .experience-card {
            grid-template-columns: 1fr;
            gap: 24px;
            padding: 18px;
        }

        .experience-image {
            height: 220px;
        }

        .experience-content {
            padding: 0 4px 8px;
        }

        .experience-header h2 {
            font-size: 28px;
        }

        .experience-divider {
            margin: 20px 0;
        }
    }
</style>
<script>
    document.addEventListener('DOMContentLoaded', () =>  {
        
        const imaReveal = document.querySelector('.ima-reveal');
        if ( ! imaReveal ) return;

        const supportObserver = 'IntersectionObserver' in window;

        const observer = supportObserver ?
            new IntersectionObserver( ( entries, obs ) => {
                entries.forEach( ( entry) => {
                    if ( entry.isIntersecting ) {
                        const card = entry.target as HTMLElement;
                    
                        card.classList.add('reveal');

                        obs.unobserve( imaReveal );
                    }
                } );
            }, { threshold: 0.1 })
        : null;

        if ( ! observer ) return;
        observer.observe(imaReveal)


    });
</script>