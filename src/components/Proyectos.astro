---
import { Image } from "astro:assets";

import Gastro from "../assets/glitched-robot-face-portrait.webp";
import finanza from "../assets/finanzas.png";
import ProyectoCard from "./ProyectoCard.astro";
import bg from "../assets/step-bg.webp";

//Proyecto número uno - mandadito
import mandadito from "../assets/mandadito.jpeg";
import mandaditoPort from "../assets/mandadito_2.jpeg";

//Proyecto número dos - gastronomia
import gastronomia from "../assets/gastronomia.png";
---

<section class="section-experience">
    <div class="section-title-sticky-height">
        <div class="section-title-and-img-sticky">
            <Image
                src={bg}
                alt="Descripción de la imagen"
                class="proyect-bg-section one"
            />
            <h2 class="title-sticky">Proyectos destacados</h2>
            <div class="sectio-ima-sticky">
                <Image
                    src={mandadito}
                    alt="Descripción de la imagen"
                    class="proyect-img two"
                />
                <Image
                    src={gastronomia}
                    alt="Descripción de la imagen"
                    class="proyect-img one"
                />
                <Image
                    src={finanza}
                    alt="Descripción de la imagen"
                    class="proyect-img three"
                />
            </div>
        </div>
    </div>
    <div class="section-information-project">
        <div class="section-project">
            <ProyectoCard
                etiqueta="Proyecto destacado"
                tituloLinea1="Sistema de gestión de"
                tituloLinea2="inventario y utensilios"
                descripcion="Sistema desarrollado para la Facultad de Gastronomía de la Universidad UTCGG, enfocado en gestionar el inventario y almacenamiento de utensilios de cocina, así como controlar su préstamo a los alumnos."
                tipo="Proyecto académico"
                periodo="Enero 2024 – Diciembre 2024"
                imagen={gastronomia}
                logros={[
                    {
                        icono: "lucide:package",
                        titulo: "Gestión de inventario",
                        descripcion:
                            "Registro y administración de utensilios de cocina y control de productos disponibles.",
                    },
                    {
                        icono: "lucide:clipboard-list",
                        titulo: "Solicitudes de préstamo",
                        descripcion:
                            "Registro y seguimiento de solicitudes de utensilios realizadas por los alumnos.",
                    },
                    {
                        icono: "lucide:users",
                        titulo: "Control de entregas",
                        descripcion:
                            "Administración de entregas y seguimiento de los utensilios asignados a cada alumno.",
                    },
                    {
                        icono: "lucide:refresh-cw",
                        titulo: "Actualización dinámica",
                        descripcion:
                            "Implementación de AJAX para actualizar información y ejecutar operaciones sin recargar las páginas.",
                    },
                ]}
                tecnologias={[
                    { icono: "logos:php", nombre: "PHP" },
                    { icono: "logos:mysql", nombre: "MySQL" },
                    { icono: "logos:javascript", nombre: "JavaScript" },
                ]}
                invertido={false}
            />
            <ProyectoCard
                etiqueta="Proyecto destacado"
                tituloLinea1="Sistema de pedidos y"
                tituloLinea2="gestión de repartos"
                descripcion="Sistema de pedidos y entregas inspirado en plataformas como Uber Eats y DiDi Food, con roles diferenciados para clientes, repartidores y administradores. Este proyecto fue un proyecto escolar por un encaro de la empresa mandadito express"
                tipo="Proyecto académico"
                periodo="Mayo 2022 – Abril 2023"
                imagen={mandaditoPort}
                imagenSecundaria={mandadito}
                imagenMini={mandadito}
                logros={[
                    {
                        icono: "lucide:users",
                        titulo: "Roles diferenciados",
                        descripcion:
                            "Flujos separados para clientes, repartidores y administradores.",
                    },
                    {
                        icono: "lucide:shopping-cart",
                        titulo: "Productos y carritos",
                        descripcion:
                            "Gestión de productos, categorías, carritos y flujo de pedidos.",
                    },
                    {
                        icono: "lucide:bike",
                        titulo: "Asignación de repartidores",
                        descripcion:
                            "El administrador asigna cada pedido a un repartidor.",
                    },
                    {
                        icono: "lucide:database",
                        titulo: "Backend y base de datos",
                        descripcion:
                            "Conexión de la aplicación con el backend para gestionar las operaciones.",
                    },
                ]}
                tecnologias={[
                    { icono: "logos:php", nombre: "PHP" },
                    { icono: "logos:mysql-icon", nombre: "MySQL" },
                    { icono: "logos:html-5", nombre: "HTML" },
                    { icono: "logos:javascript", nombre: "JavaScript" },
                    { icono: "lucide:arrow-left-right", nombre: "AJAX" },
                ]}
                invertido={true}
            />
            <ProyectoCard
                etiqueta="Proyecto destacado"
                tituloLinea1="Sistema de pedidos y"
                tituloLinea2="gestión de repartos"
                descripcion="Sistema de pedidos y entregas inspirado en plataformas como Uber Eats y DiDi Food, con roles diferenciados para clientes, repartidores y administradores."
                tipo="Proyecto académico"
                periodo="Mayo 2022 – Abril 2023"
                imagen={gastronomia}
                logros={[
                    {
                        icono: "lucide:users",
                        titulo: "Roles diferenciados",
                        descripcion:
                            "Flujos separados para clientes, repartidores y administradores.",
                    },
                    {
                        icono: "lucide:shopping-cart",
                        titulo: "Productos y carritos",
                        descripcion:
                            "Gestión de productos, categorías, carritos y flujo de pedidos.",
                    },
                    {
                        icono: "lucide:bike",
                        titulo: "Asignación de repartidores",
                        descripcion:
                            "El administrador asigna cada pedido a un repartidor.",
                    },
                    {
                        icono: "lucide:database",
                        titulo: "Backend y base de datos",
                        descripcion:
                            "Conexión de la aplicación con el backend para gestionar las operaciones.",
                    },
                ]}
                tecnologias={[
                    { icono: "logos:angular-icon", nombre: "Angular" },
                    { icono: "logos:nestjs", nombre: "NestJS" },
                ]}
                invertido={false}
            />
        </div>
    </div>
</section>

<style>
    .proyect-bg-section {
        width: 100%;
        height: 100%;
        opacity: 1;
        object-fit: cover;
        position: absolute;
    }

    .section-experience {
        width: 100%;
        height: auto;
        background: #000107;
        background: #fff;
        background: #f0f2f4;
        position: relative;
        z-index: 2000;
    }

    .section-title-sticky-height {
        --height-content: auto;
        width: 100%;

        height: var(--height-content);
        display: flex;
        align-items: start;

        justify-content: center;
    }

    .section-title-and-img-sticky {
        width: 100%;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: sticky;
        top: 0;

        background:
            linear-gradient(
                115deg,
                transparent 0 18%,
                rgb(#000107) 18.1% 18.45%,
                transparent 18.7% 100%
            ),
            linear-gradient(145deg, rgba(122, 92, 255, 0.2), transparent 34%),
            linear-gradient(315deg, rgba(255, 23, 79, 0.14), transparent 36%),
            linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent 36%),
            #080912;
    }

    .title-sticky {
        --translateY: 0;
        --opacidad: 1;

        transform: translateY(var(--translateY));
        opacity: var(--opacidad);

        z-index: 10;

        font-size: 57px;
        font-weight: 700;
        /* color: #dce6ee; */
        color: #eaebee;
        letter-spacing: -2.5;
        line-height: 1;
    }

    .sectio-ima-sticky {
        width: 90%;
        height: 90%;
        position: absolute;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .proyect-img {
        --scaleVal: 1;
        transform: scale(var(--scaleVal));
        position: absolute;
        object-fit: cover;
        border-radius: 3px;
    }

    .proyect-img.one {
        width: 180px;
        height: 180px;
        left: 0;
        right: 0;
        margin: auto;
        top: 10%;
    }

    .proyect-img.two {
        width: 230px;
        height: 270px;
        top: 25%;
        left: 0%;
    }

    .proyect-img.three {
        width: 230px;
        height: 250px;
        top: 40%;
        right: 2%;
    }

    .section-information-project {
        width: 100%;
        height: auto;
        background: #f0f2f4;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .section-project {
        width: 95%;
        height: auto;
        display: flex;
        padding: 5.7rem 0;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 40px;
    }
</style>

<script>
    interface ObjectImgPosition {
        element: HTMLElement;
        startX: number;
        startY: number;
        endX: number;
        endY: number;
    }

    document.addEventListener("DOMContentLoaded", () => {
        const sectionSticky = document.querySelector(
            ".section-title-sticky-height",
        ) as HTMLElement | null;
        const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        const sectioImaSticky = document.querySelectorAll(".proyect-img");
        const sectionImgProyect =
            document.querySelectorAll<HTMLElement>(".proy_main-img");

        const titleSticky = document.querySelector(
            ".title-sticky",
        ) as HTMLElement | null;
        const supportIntersectionObserver = "IntersectionObserver" in window;

        const objectImgPosition: ObjectImgPosition[] = [];

        sectioImaSticky.forEach((ele, index) => {
            const rect = sectionImgProyect[index].getBoundingClientRect();
            const rectEle = ele.getBoundingClientRect();
            objectImgPosition.push({
                element: ele as HTMLElement,
                startX: rectEle.left + window.scrollX,
                startY: rectEle.top + window.scrollY,
                endX: rect.left + window.scrollX,
                endY: rect.top + window.scrollY,
            });
        });

        if (!sectionSticky) return;

        let ticking: boolean = false;
        let start: number = 0;
        let end: number = 0;

        let secondStart = 0;
        let secondEnd = 0;

        const SMOOTH: number = 0.12;
        const SMOOTH_EPSILON: number = 0.001;
        let actual: null | number = null;
        let secondHow: null | number = null;

        const clamp = (val: number, min: number, max: number): number => {
            return Math.max(min, Math.min(val, max));
        };

        const lerp = (
            start: number,
            end: number,
            actual: number | null,
        ): number => {
            if (typeof actual !== "number") return 0;
            return start + (end - start) * actual;
        };

        const updateAnimation = (): boolean => {
            const rect = sectionSticky.getBoundingClientRect();
            if (!rect) return false;

            const rawProgress = (start - rect.top) / (start - end);
            const progress = clamp(rawProgress, 0, 1);

            if (actual === null) {
                actual = progress;
            } else {
                actual += (progress - actual) * SMOOTH;
            }

            if (Math.abs(progress - actual) < SMOOTH_EPSILON) {
                actual = progress;
            }

            const rawProgressSecond =
                (secondStart - rect.top) / (secondStart - secondEnd);
            const progressSecond = clamp(rawProgressSecond, 0, 1);

            if (secondHow === null) {
                secondHow = progressSecond;
            } else {
                secondHow += (progressSecond - secondHow) * SMOOTH;
            }

            if (Math.abs(progressSecond - secondHow) < SMOOTH_EPSILON) {
                secondHow = progressSecond;
            }

            if (actual === null) return false;

            sectioImaSticky.forEach((element) => {
                if (actual) {
                    (element as HTMLElement).style.setProperty(
                        "--scaleVal",
                        actual.toString(),
                    );
                }
            });

            if (!titleSticky) return false;
            titleSticky.style.setProperty("--opacidad", actual.toString());

            const translateY = 200 + (0 - 200) * actual;

            titleSticky.style.setProperty(
                "--translateY",
                translateY.toString(),
            );

            objectImgPosition.forEach((item) => {
                const x = lerp(item.startX, item.endX, secondHow) - item.startX;
                const y = lerp(item.startY, item.endY, secondHow) - item.startY;

                const opacityVal = lerp(1, 0, secondHow);
                item.element.style.transform = `translate(${x}px, ${y}px) scale(${actual}) `;

                item.element.style.opacity = opacityVal.toString();
            });

            return actual !== progress || secondHow !== progressSecond;
        };

        const tick = () => {
            if (updateAnimation()) {
                requestAnimationFrame(tick);
            } else {
                ticking = false;
            }
        };

        const requestUpdate = () => {
            if (ticking) return;

            ticking = true;
            requestAnimationFrame(tick);
        };

        const observer = supportIntersectionObserver
            ? new IntersectionObserver((entries) => {
                  entries.forEach((entry) => {
                      if (entry.isIntersecting) {
                          window.addEventListener("scroll", requestUpdate, {
                              passive: true,
                          });
                      } else {
                          window.removeEventListener("scroll", requestUpdate);
                      }
                  });
              })
            : null;

        const animation = () => {
            if (!observer) return;
            observer.observe(sectionSticky);
        };

        const initSectionAnimation = () => {
            const sectioImaSticky = document.querySelectorAll(".proyect-img");

            if (!sectionSticky || !titleSticky || sectioImaSticky.length === 0)
                return;

            sectionSticky.style.setProperty("--height-content", "1400px");
            titleSticky.style.setProperty("--translateY", "200px");
            titleSticky.style.setProperty("--opacidad", "0");

            sectioImaSticky.forEach((ima) => {
                (ima as HTMLElement).style.setProperty("--scaleVal", "0");
            });

            const rect = sectionSticky.getBoundingClientRect();
            const vh = window.innerHeight;

            start = vh * 0.6;
            end = 0;

            secondStart = -100;
            secondEnd = vh - rect.height;
        };

        if (!reduceMotion) {
            initSectionAnimation();
            animation();
        }
    });
</script>
