---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---

<header class="myheader">
    <div class="content-header">
        <div class="container-logo">
            <Image src={logo} alt="Descripción de la imagen" />
        </div>

        <div class="content-nav">
            <nav>
                <ul>
                    <li>Inicio</li>
                    <li>Acerca de mí</li>
                    <li>Experiencia</li>
                    <li>Proyectos</li>
                    <li>Stack</li>
                    <li>Contacto</li>
                </ul>
            </nav>
        </div>
    </div>
</header>

<style>
    .myheader { 
        margin: 0;
        padding: 0;
        width: 100%;
        height: 60px;
        display: flex;
        align-items: center;
        top: 30px;
        z-index: 100;
        position: absolute;
        justify-content: center;
    } 

    .content-header { 
        width: 95%;
        height: 60px;
        display: flex;
        border-radius: 3px;
        align-items: center;
        justify-content: space-between;
        backdrop-filter: blur(32px) saturate(185%);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0) 45%), linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0.14) 38%, rgba(255, 255, 255, 0) 62%, rgba(96, 88, 168, 0.07) 100%), linear-gradient(120deg, rgba(255, 255, 255, 0.42) 0%, rgba(248, 250, 255, 0.16) 46%, rgba(196, 181, 253, 0.18) 100%), rgba(248, 250, 255, 0.58);
    } 

    .container-logo { 
        width: 20%;
        height: 60px;
         display: flex;
        align-items: center;
        justify-content: center;
    } 

    .container-logo img { 
        width: 90px;
        height: 55px;
    } 

    .content-nav { 
        width: 70%;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
    } 

    .content-nav nav  { 
        width: 95%;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
    } 

    .content-nav nav ul { 
         width: 100%;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: space-evenly;
    } 

    li {
        font-size: 15px;
        font-weight: 500;
        color: #110a36f2;
        letter-spacing: 0;
        list-style: none;
    } 
</style>