---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import imajose from "../assets/FeaturedImage3-4-compressed.png";
import fondoNeon from "../assets/dark-blue-light-glitch-background.webp";

const contacto = [
    { color: "purple", icono: "lucide:map-pin", texto: "Ciudad de México. Mx" },
    { color: "red", icono: "lucide:phone", texto: "+52 758 109 2916" },
    { color: "blue", icono: "lucide:mail", texto: "jcuevashernandez275" },
];

const tecnologias = [
    { icono: "logos:nodejs-icon", nombre: "NodeJs" },
    { icono: "logos:angular-icon", nombre: "Angular" },
    { icono: "simple-icons:express", nombre: "ExpressJs" },
    { icono: "logos:typescript-icon", nombre: "TypeScript" },
    { icono: "logos:nestjs", nombre: "NestJS" },
    { icono: "logos:docker-icon", nombre: "Docker" },
];
---

<section class="hero-presentation">
    <div class="hero-container">
        <div class="container-info">
            <div class="content-bad">
                <div class="content-bad-text">
                    <p> { "< Programador Full Stack />" }</p>
                </div>
            </div>
            <div class="title-cont">
                <div class="title-text">Hola, soy</div>
                <div class="text-color">Juan de la Cruz</div>
                <div class="text-color">Cuevas Hernández</div>
            </div>
            <div class="content-description">
                <p class="desc-text">
                    Soy Programador Full Stack con experiencia en el desarrollo
                    de aplicaciones web, integración de APIs REST y creación de
                    soluciones digitales utilizando tecnologías como Angular,
                    TypeScript, NestJS y Express.
                </p>
            </div>
            <div class="content-buttons">
                <div class="buttons-section">
                    <div class="buttons">
                        <button class="mybuttons gradient">
                            Ver Experiencia
                            <span class="mybuttons__icon">
                                <Icon name="lucide:arrow-right" />
                            </span>
                        </button>
                    </div>

                    <div class="buttons">
                        <button class="mybuttons cv">
                            <span class="mybuttons__icon">
                                <Icon name="lucide:download" />
                            </span>
                            Descargar CV
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-image">
            <Image
                src={imajose}
                alt="Descripción de la imagen"
                class="ima-perfil"
            />

            <div class="floatin-tec">
                <div class="float-card">
                    {
                        tecnologias.map((tec) => (
                            <div class="card-list">
                                <Icon name={tec.icono} class="ima-tec" />
                                <p>{tec.nombre}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>

    <Image 
        src={fondoNeon}
        alt="Descripción de la imagen"
        class="fondo-neon" 
    />
    <canvas class="mycanvas" id="mycanvashero"></canvas>
</section>

<style>
    .hero-presentation {
        width: 100%;
        height: 650px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000107;
        z-index: 2;
        flex-direction: column;
    }

    .hero-container {
        width: 85%;
        height: 620px;
        display: flex;
        gap: 20px;
        align-items: center;
        z-index: 75;
        justify-content: center;
    }

    .container-info {
        width: 50%;
        height: 420px;
        display: flex;
        justify-content: end;
        flex-direction: column;
        gap: 30px;
        z-index: 55;
    }

    .content-bad {
        width: 100%;
        height: 60px;
        display: flex;
        align-items: end;
    }

    .content-bad-text {
        width: fit-content;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        padding: 0 15px;
        background: linear-gradient(to right, #c605e8, #08befd);
    }

    .content-bad-text p {
        color: #f6f7ff;
        font-weight: 300;
        font-size: 16px;
    }

    .title-cont {
        width: 100%;
        height: 150px;
        display: flex;
        justify-content: center;
        flex-direction: column;
    }

    /* "HOLA, SOY": pequeño, en mayúsculas y con letras separadas */
    .title-text {
        margin-bottom: 0.9rem;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #9aa6c4;
        line-height: 1;
    }

    /* Las dos líneas del nombre */
    .text-color {
        font-size: clamp(2.2rem, 4.4vw, 3.7rem);
        font-weight: 800;
        line-height: 1;
        text-transform: uppercase;
        letter-spacing: -0.02em;
    }

    /* Línea 1: blanca */
    .text-color:nth-child(2) {
        color: #fff;
        background: none;
    }

    /* Línea 2: degradado azul a violeta */
    .text-color:nth-child(3) {
        width: fit-content;
        background: linear-gradient(
            90deg,
            #2f7bff 0%,
            #6d5cff 60%,
            #8b5cf6 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .content-description {
        width: 75%;
        height: 90px;
        display: flex;
        align-items: center;
        gap: 25px;
        justify-content: space-between;
    }

    .content-description::before {
        content: "";
        width: 2px;
        height: 80px;
        background: #8d05f8;
    }

    .content-description .desc-text {
        color: #e5e6f3;
        font-size: 15px;
    }

    .buttons-section {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .mybuttons {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.9rem;
        height: 56px;
        border: 0;
        border-radius: 6px;
        font-family: inherit;
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
        cursor: pointer;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .mybuttons:hover {
        transform: translateY(-2px);
    }

    /* Círculo del icono */
    .mybuttons__icon {
        width: 35px;
        height: 35px;
        display: grid;
        place-items: center;
        border-radius: 6px;
        flex-shrink: 0;
        transition: transform 0.2s ease;
    }

    .mybuttons__icon :global(svg) {
        width: 20px;
        height: 20px;
    }

    /* ---------- Botón 1: degradado ---------- */
    .mybuttons.gradient {
        padding: 0 2rem 0 2.5rem;
        background: linear-gradient(
            90deg,
            #b01ee0 0%,
            #e8346f 60%,
            #ff4a2a 100%
        );

        border: 3px solid #fff;
    }

    .mybuttons.gradient .mybuttons__icon {
        background: #fff1f3;
        color: #f0403a;
    }

    .mybuttons.gradient:hover .mybuttons__icon {
        transform: translateX(3px);
    }

    /* puntito decorativo abajo a la izquierda */
    .mybuttons.gradient::before {
        content: "";
        position: absolute;
        left: 14px;
        bottom: 6px;
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #e8b4ff;
    }

    /* ---------- Botón 2: contorno ---------- */
    .mybuttons.cv {
        padding: 0 2.5rem 0 2rem;
        background: rgba(10, 16, 48, 0.193);
        border: 1px solid #5b5cf0;
    }

    .mybuttons.cv .mybuttons__icon {
        border: 1.5px solid rgba(255, 255, 255, 0.9);
        color: #fff;
    }

    .mybuttons.cv:hover .mybuttons__icon {
        transform: translateY(2px);
    }

    /* punto azul decorativo abajo a la derecha */
    .mybuttons.cv::after {
        content: "";
        position: absolute;
        right: 18px;
        bottom: -4px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #3b82f6;
    }

    .container-image {
        width: 50%;
        height: 650px;
        display: flex;
        align-items: end;
        position: relative;
        justify-content: center;
        z-index: 3;
    }

    .container-image .ima-perfil {
        position: relative;
        width: 100%;
        height: 580px;
        filter: drop-shadow(0 0 8px #0e2675) drop-shadow(0 0 20px #102d8c);
    }

    .floatin-tec {
        width: 190px;
        height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(to right, #010613, #020e2c);
        z-index: 2;
        position: absolute;
        top: 120px;
        right: -50px;

        clip-path: polygon(
            20px 0,
            /* arriba, después del corte izq. */ 100% 0,
            /* arriba derecha */ 100% calc(100% - 20px),
            /* derecha, antes del corte inferior */ calc(100% - 20px) 100%,
            /* abajo, antes del corte der. */ 0 100%,
            /* abajo izquierda */ 0 20px /* izquierda, debajo del corte */
        );
        border-radius: 6px;
        border: 1px solid #efd4f460;
    }

    .float-card {
        width: 150px;
        height: 210px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 2px;
    }

    .card-list {
        width: 100%;
        height: 35px;
        display: flex;
        gap: 10px;
        align-items: center;
        flex-direction: row;
    }

    .ima-tec {
        width: 20px;
        height: 20px;
        object-fit: cover;
    }

    .card-list p {
        color: #afb4e1;
        font-size: 14px;
    }

    .fondo-neon {
        width: 100%;
        height: 100%;
        position: absolute;
        bottom: 0;
        object-fit: cover;
        opacity: 1;
    }

    .mycanvas {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        z-index: 50;
    }
</style>

<script>
    import type { myLineas } from "../types/lineas";

    document.addEventListener("DOMContentLoaded", () => {
        const canvas =
            document.querySelector<HTMLCanvasElement>("#mycanvashero");

        if (!canvas) return;

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const updatePantalla = () => {
            canvas.width = window.innerWidth;
            canvas.height = 670;
        };
        updatePantalla();
        window.addEventListener("resize", updatePantalla);

        const cannt = 12;
        const arrLineas: myLineas[] = [];

        class Lluvia {
            x: number;
            y: number;
            l: number;
            v: number;
            opa: number;

            constructor(canvas: HTMLCanvasElement) {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * -canvas.height;
                this.v = 2 + Math.random() * 12;
                this.l = 40 + Math.random() * 60;
                this.opa = 0.3 + Math.random() * 0.5;
            }

            drawLineas(): void {
                if (!ctx) return;
                const gradiente = ctx.createLinearGradient(
                    this.x,
                    this.y,
                    this.x,
                    this.y + this.l,
                );
                gradiente.addColorStop(0, "rgba(174, 219, 255, 0)"); // Desaparece arriba
                gradiente.addColorStop(1, `rgba(174, 219, 255, ${this.opa})`); // Punta brillante abajo

                ctx.beginPath();
                ctx.moveTo(this.x, this.y);
                ctx.lineTo(this.x, this.y + this.l);

                ctx.strokeStyle = gradiente;
                ctx.lineWidth = 2;
                ctx.lineCap = "round";
                ctx.stroke();
            }

            updateLineas(): void {
                this.y += this.v;

                if (!canvas) return;

                if (this.y - this.l > canvas.height) {
                    this.reset();
                }
            }

            reset(): void {
                if (!canvas) return;
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * -canvas.height;
                this.v = 2 + Math.random() * 2;
                this.l = 40 + Math.random() * 60;
                this.opa = 0.3 + Math.random() * 0.5;
            }
        }

        const create = () => {
            for (let i = 0; i < cannt; i++) {
                arrLineas.push(new Lluvia(canvas));
            }
        };

        create();

        const animar = () => {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            arrLineas.forEach((linea) => {
                linea.updateLineas();
                linea.drawLineas();
            });

            requestAnimationFrame(animar);
        };
        animar();
    });
</script>
